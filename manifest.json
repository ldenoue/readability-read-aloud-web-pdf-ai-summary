{
  "manifest_version": 3,
  "name": "Readability Read Aloud",
  "version": "0.24.0",
  "description": "Extract articles and PDFs, generate private local AI summaries, and read them aloud with local TTS.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["https://huggingface.co/*", "file:///*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Summarize and read this page or PDF aloud",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
